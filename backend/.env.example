# Runtime
APP_ENV=development
PORT=8080
API_BASE_PATH=/api/v1
PUBLIC_BASE_URL=http://localhost:8080
LOG_LEVEL=info
REQUEST_BODY_LIMIT_MB=20

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Local storage and exports
REPOSITORY_TYPE=memory
SQLITE_PATH=../data/novelscript.db
DATA_DIR=../data
EXPORT_DIR=../data/exports

# Source parsing limits
MIN_CHAPTER_COUNT=3
MAX_CHAPTER_COUNT=80
MAX_CHAPTER_CHARS=20000

# Generation jobs
JOB_STEP_DELAY_MS=180
JOB_TIMEOUT_SECONDS=180
JOB_MAX_PARALLEL=2

# YAML schema
SCRIPT_SCHEMA_PATH=../schemas/script.schema.json

# Model provider settings. Fill these in before wiring the real provider.
MODEL_PROVIDER=
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_ORG_ID=
MODEL_PROJECT_ID=
MODEL_NAME=
MODEL_TIMEOUT_SECONDS=120
MODEL_MAX_RETRIES=2
MODEL_MAX_INPUT_CHARS=24000
MODEL_MAX_OUTPUT_TOKENS=6000
MODEL_TEMPERATURE=0.4
MODEL_STRUCTURE_MODE=json_schema
MODEL_PROMPT_VERSION=script-draft-v1
